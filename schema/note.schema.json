{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Claire-Vu/HarborDeck/schema/note.schema.json",
  "title": "HarborDeck note line",
  "description": "One line of <HARBORDECK_HOME>/notes.jsonl: something an agent said about an existing item or topic, kept with it instead of lost in chat. Append only. Unknown fields are allowed and ignored.",
  "type": "object",
  "required": ["text", "at"],
  "anyOf": [{ "required": ["item"] }, { "required": ["topic"] }],
  "properties": {
    "item": { "$ref": "#/$defs/slug", "description": "Item id the note is about." },
    "topic": { "$ref": "#/$defs/slug", "description": "Topic the note belongs to. With item, the item's topic when the note was written. A topic nothing else uses yet is created by its first note." },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "One or two plain sentences." },
    "artifact": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "url": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*:" },
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "maxLength": 200 }
      },
      "oneOf": [{ "required": ["url"] }, { "required": ["path"] }]
    },
    "from": { "type": "string", "maxLength": 100 },
    "at": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}
