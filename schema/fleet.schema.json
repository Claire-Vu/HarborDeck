{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Claire-Vu/HarborDeck/schema/fleet.schema.json",
  "title": "HarborDeck fleet snapshot",
  "description": "<HARBORDECK_HOME>/fleet.json. Optional. Status and flavour only; nothing in the app controls the crew.",
  "type": "object",
  "properties": {
    "generated": { "type": "integer", "minimum": 0 },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "firstmates": {
      "type": "array",
      "description": "Agents the user talks to (request targets).",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "domain": { "type": "string" },
          "harness": { "type": "string" },
          "model": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "crew": {
      "type": "array",
      "description": "Workers behind the agents.",
      "items": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "firstmate": { "type": "string" },
          "harness": { "type": "string" },
          "model": { "type": "string" },
          "effort": { "type": "string" },
          "state": { "enum": ["idle", "working", "waiting", "done"] },
          "task": { "type": "string" },
          "task_title": { "type": "string" },
          "item": { "type": "string", "description": "Item id this worker waits on." },
          "project": { "type": "string" },
          "shipped": { "type": "integer", "minimum": 0 },
          "rework": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "regulars": {
      "type": "array",
      "description": "One per stream or project.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "shipped": { "type": "integer", "minimum": 0 },
          "rework": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "item": { "type": "string" },
          "state": { "enum": ["proposed", "approved", "building", "installed"] }
        }
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  }
}
